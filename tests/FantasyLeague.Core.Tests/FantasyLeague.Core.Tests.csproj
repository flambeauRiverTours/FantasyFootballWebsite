<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Sleeper payloads; see tests/fixtures/README.md -->
    <Content Include="..\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FantasyLeague.Core\FantasyLeague.Core.csproj" />
    <ProjectReference Include="..\..\src\FantasyLeague.Sleeper\FantasyLeague.Sleeper.csproj" />
    <ProjectReference Include="..\..\src\FantasyLeague.Seasons\FantasyLeague.Seasons.csproj" />
    <ProjectReference Include="..\..\src\FantasyLeague.Cli\FantasyLeague.Cli.csproj" />
    <ProjectReference Include="..\..\src\FantasyLeague.Data\FantasyLeague.Data.csproj" />
  </ItemGroup>

</Project>